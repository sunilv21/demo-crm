
/**
 * @file firestore.rules
 * @description Firestore Security Rules for the Sky Visa CRM application.
 *
 * @version 6
 *
 * Simplified ruleset. Internal-CRM trust model:
 *   • All signed-in users can READ everything except invoices.
 *   • Owners can manage their own attendance / leave records.
 *   • Admin can correct anything.
 *   • Critical sensitive fields on /users (role, salary, shift, monthlyLeaveCap)
 *     are locked to Admin-only writes via direct equality checks (no diff() —
 *     simpler & more compatible).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    // Returns the role of the requesting user, or null if their /users doc
    // is missing. The exists() check is critical — without it, get() throws
    // for any user without a profile doc and that throw poisons the entire
    // rule expression (including unrelated || branches that would otherwise
    // allow the operation).
    function userRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function isAdmin() {
      return userRole() == 'admin';
    }
    function isAdminOrManager() {
      return userRole() == 'admin' || userRole() == 'manager';
    }
    // True when the given client is assigned to the requesting user. Uses get()
    // (which bypasses read rules), guarded by exists() so a missing client
    // doesn't throw and poison the whole rule expression.
    function clientAssignedToMe(clientId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/clients/$(clientId))
        && request.auth.uid in get(/databases/$(database)/documents/clients/$(clientId)).data.assignedEmployees;
    }
    // A public lead-capture submission (from /lead?source=... posted on social
    // media). Allowed unauthenticated, but tightly shaped to limit abuse:
    // must be a brand-new lead, marked public, with a name and phone.
    function isValidPublicLead() {
      let d = request.resource.data;
      return d.status == 'new'
        && d.createdBy == 'public_form'
        && d.name is string && d.name.size() > 1 && d.name.size() < 200
        && d.phone is string && d.phone.size() > 0 && d.phone.size() < 40;
    }
    // A public client intake (/intake form) submission. Same idea as above:
    // unauthenticated, but must be a public-tagged lead-status record with a
    // name and phone.
    function isValidPublicClient() {
      let d = request.resource.data;
      return d.status == 'lead'
        && d.createdBy == 'public_form'
        && d.name is string && d.name.size() > 1 && d.name.size() < 200
        && d.phone is string && d.phone.size() > 0 && d.phone.size() < 40;
    }

    // -------------------------------------------------------------------------
    // Users
    //   • Anyone signed-in can read user profiles (needed for role resolution,
    //     Team View, etc).
    //   • Self-create allowed (signup flow + AppUserProvider auto-provision).
    //   • Admin can update anything; owner can update their own profile but
    //     CANNOT change role / baseSalary / workStartTime / workEndTime /
    //     lateGraceMinutes / monthlyLeaveCap.
    //   • Only admin can delete.
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && request.resource.data.id == userId;

      allow update: if isSignedIn()
                    && request.resource.data.id == resource.data.id
                    && (
                      isAdmin()
                      || (
                        isOwner(userId)
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.baseSalary == resource.data.baseSalary
                        && request.resource.data.workStartTime == resource.data.workStartTime
                        && request.resource.data.workEndTime == resource.data.workEndTime
                        && request.resource.data.lateGraceMinutes == resource.data.lateGraceMinutes
                        && request.resource.data.monthlyLeaveCap == resource.data.monthlyLeaveCap
                        && request.resource.data.dailyBreakCapMinutes == resource.data.dailyBreakCapMinutes
                      )
                    );

      allow delete: if isAdmin();
    }

    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Core business collections
    // -------------------------------------------------------------------------
    // Bookings are stored as a flat top-level collection. Each doc has a
    // `clientId` field; per-client views use where('clientId','==',id).
    // Bookings: admins/managers see all. Everyone else may read/update a booking
    // only if they created it OR it belongs to a client assigned to them.
    // List queries for non-admins MUST be constrained (where createdBy == uid,
    // or where clientId == <an assigned client>) or Firestore rejects them.
    match /bookings/{id} {
      allow read, update: if isSignedIn() && (
                             isAdminOrManager()
                             || resource.data.createdBy == request.auth.uid
                             || clientAssignedToMe(resource.data.clientId)
                           );
      allow create: if isSignedIn();
      allow delete: if isAdminOrManager();
    }

    // Clients: admins/managers see all. Everyone else may read/update only
    // clients assigned to them or that they created. Non-admin list queries
    // MUST be constrained by where('assignedEmployees','array-contains', uid).
    match /clients/{id} {
      allow read, update: if isSignedIn() && (
                             isAdminOrManager()
                             || (request.auth.uid in resource.data.assignedEmployees)
                             || resource.data.createdBy == request.auth.uid
                           );
      // Public intake form (/intake) writes here unauthenticated; staff can
      // also create clients while signed in.
      allow create: if isSignedIn() || isValidPublicClient();
      allow delete: if isAdminOrManager();

      match /itineraries/{itineraryId} {
        allow read, create, update: if isSignedIn();
        allow delete: if isAdminOrManager();
      }
    }

    match /customer_logs/{id} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdminOrManager();
    }

    match /follow_ups/{id} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdminOrManager();
    }

    match /leads/{id} {
      allow read, update: if isSignedIn();
      // Public lead-capture form (/lead) writes here unauthenticated; staff can
      // also create leads while signed in.
      allow create: if isSignedIn() || isValidPublicLead();
      allow delete: if isAdminOrManager();
    }

    match /invoices/{id} {
      allow read: if isAdminOrManager();
      allow write: if isAdmin();
    }

    match /process_tracking/{id} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdminOrManager();
    }

    match /customer_statuses/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // HR — Attendance / Leaves / Holidays
    // -------------------------------------------------------------------------

    function isAttendanceOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }
    function isNewAttendanceOwner() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    // Doc id format is `${uid}_${YYYY-MM-DD}` so we can verify ownership from
    // the path alone — works even when the document doesn't exist yet, which
    // the get/exists probe in the idempotent auto-punch-in needs.
    function isOwnerByPath(docId) {
      return isSignedIn() && docId.split('_')[0] == request.auth.uid;
    }

    // Attendance:
    //   - Admin can get/list every employee's attendance.
    //   - Employees can get/list only records where userId == request.auth.uid.
    //     Firestore will allow employee LIST queries only when the query is
    //     constrained by where('userId', '==', request.auth.uid).
    //   - For GET, we also allow non-existent docs whose path uid matches the
    //     caller — needed so `getDoc` existence probes don't error out before
    //     a record is created on the day's first punch-in.
    //   - Owners can create their own day record (deterministic id ties one
    //     doc per uid per date — prevents duplicate punch-in on re-login).
    //   - Owners can UPDATE their record (punchOut, breaks, status), but
    //     `punchIn` and `date` are locked — only an admin can rewrite those.
    match /attendance/{id} {
      allow get: if isAdmin()
                 || isOwnerByPath(id)
                 || isAttendanceOwner();
      allow list: if isAdmin() || isAttendanceOwner();

      allow create: if isNewAttendanceOwner()
                    && id == request.auth.uid + '_' + request.resource.data.date;
      allow update: if isAdmin()
                    || (isAttendanceOwner()
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.punchIn == resource.data.punchIn
                        && request.resource.data.date == resource.data.date);
      allow delete: if isAdmin();
    }

    // Leaves: signed-in users read all (Team View). Owner creates own pending
    // request; owner can edit fields of own pending request but CANNOT flip
    // status (no self-approval). Admin approves / rejects.
    match /leaves/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin()
                    || (
                      isSignedIn()
                      && resource.data.userId == request.auth.uid
                      && resource.data.status == 'pending'
                      && request.resource.data.status == 'pending'
                      && request.resource.data.userId == resource.data.userId
                    );
      allow delete: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && resource.data.status == 'pending');
    }

    // Holidays: read by all; only admin manages.
    match /holidays/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
