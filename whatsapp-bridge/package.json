{
  "name": "whatsapp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Node service that runs whatsapp-web.js sessions and syncs them to Firestore. Not part of the Next.js app — run alongside it with `npm run dev`.",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "firebase-admin": "^14.1.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.26.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
